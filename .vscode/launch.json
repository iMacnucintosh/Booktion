    "version": "0.2.0",
    "configurations": [
        {
            "name": "Booktion (Debug)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/.env"
            ]
        },
        {
            "name": "Booktion (Profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/.env"
            ]
        },
        {
            "name": "Booktion (Release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/.env"
            ]
        }
    ]
}